# Database (MySQL)
DATABASE_URL=mysql://user:password@host:3306/dbname

# Manus OAuth (required for login)
MANUS_CLIENT_ID=your_manus_client_id
MANUS_CLIENT_SECRET=your_manus_client_secret
MANUS_REDIRECT_URI=https://yourdomain.com/api/oauth/callback

# JWT session secret (auto-generated if not set)
SESSION_SECRET=your_session_secret_min_32_chars

# AI Chatbot (Phase F)
ANTHROPIC_API_KEY=sk-ant-...

# Storage (optional — for image uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# App
NODE_ENV=production
PORT=3000
